{
  "name": "buildfromvision-assembly-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BuildFromVision — Assembly Studio MVP: illustrated, narrated assembly walkthroughs from structured JSON",
  "scripts": {
    "dev": "concurrently -k -n web,bom -c auto \"npm:dev:web\" \"npm:bom-api\"",
    "dev:web": "vite",
    "bom-api": "uv run python main.py serve --port 8001",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:adapter": "node test-adapter.mjs",
    "test:analysis": "node test-analysis.mjs",
    "test": "node test-adapter.mjs && node test-analysis.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "lucide-react": "^1.77.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
