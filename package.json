{
  "name": "buildfromvision-assembly-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BuildFromVision — Assembly Studio MVP: illustrated, narrated assembly walkthroughs from structured JSON",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:adapter": "node test-adapter.mjs",
    "test:analysis": "node test-analysis.mjs",
    "test": "node test-adapter.mjs && node test-analysis.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
