

# ---------------------------------------------------------------- PARTS API ---
# The team's Parts & Shop service (the `hein-parts` branch), which returns real
# LCSC and Mouser stock and prices. Entirely optional: leave it blank and the app
# falls back to the retailer search links it generates itself.
#
#   cd backend && .venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
#
# VITE_PARTS_API_URL=http://localhost:8000
