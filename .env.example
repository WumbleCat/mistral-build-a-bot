# Copy to .env and fill in. Never commit .env.

# --- Vision / reasoning API (Mistral by default) ---------------------------
# Either variable works as the key; VISION_API_KEY wins if both are set.
MISTRAL_API_KEY=
# VISION_API_KEY=

# Any OpenAI-compatible /chat/completions endpoint. Default: Mistral.
# VISION_API_BASE_URL=https://api.mistral.ai/v1
# Must be a vision-capable chat model. Default: mistral-large-latest
# MISTRAL_MODEL (or VISION_MODEL, which wins if both are set).
# MISTRAL_MODEL=mistral-large-latest
# Model for the text-only inference pass (defaults to VISION_MODEL).
# REASONING_MODEL=
# json_object (default) or none, for providers without JSON mode.
# VISION_JSON_MODE=json_object
# Seconds to wait for one model reply (default 300). A slow reply is retried once.
# VISION_TIMEOUT_S=300
# Extra attempts after a malformed model response.
# VISION_MAX_RETRIES=2
# 1 (default) = re-check every listed part for direct visibility; 0 = skip (one call fewer per image).
# VISION_VERIFY=1

# --- Detection mode ----------------------------------------------------------
# 0 / unset (default) = VLM/LLM only. 1 = also locate parts with local Grounding DINO + SAM 2
# (needs torch, transformers and sam2 - see README). The web dropdown and
# --grounding / --no-grounding override this per run.
# ROBOT_BOM_GROUNDING=0
# GROUNDING_DINO_MODEL=IDEA-Research/grounding-dino-tiny
# GROUNDING_SAM_MODEL=facebook/sam2.1-hiera-tiny
# GROUNDING_BOX_THRESHOLD=0.25
# GROUNDING_TEXT_THRESHOLD=0.20

# --- AI best guess ----------------------------------------------------------
# 1 (default) = look each inferred part up on the approved shops with Mistral's web search
# tool (one billed search conversation per part) and check stock on the pages found.
# 0 = only build shop search links.
# ROBOT_BOM_WEB_SEARCH=1

# --- Offline development ----------------------------------------------------
# 1 = always use the canned mock client (same as --mock).
# ROBOT_BOM_MOCK=0

# --- Optional product catalog (leave unset: "Catalog lookup not configured") -
# GET {CATALOG_API_URL}?q=<query> -> [{"title","product_url","vendor","sku","price","currency"}]
# CATALOG_API_URL=
# CATALOG_API_KEY=

# --- Parts & Shop service (Person 3, branch hein-parts) ----------------------
# server/api.ts proxies parts lookups / BOM / live offers to this base URL.
# Run it from the hein-parts worktree: cd ../parts-service/backend && .venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
# HEIN_PARTS_URL=http://localhost:8000
