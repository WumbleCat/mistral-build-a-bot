# Copy to .env and fill in. All keys stay server-side (used only by the Vite dev-server API routes).
MISTRAL_API_KEY=
# Optional: Mistral image-generation agent id (agents API) or a direct image model name.
MISTRAL_IMAGE_AGENT_ID=
MISTRAL_IMAGE_MODEL=
# Optional: override the Mistral API base URL (default https://api.mistral.ai/v1)
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
