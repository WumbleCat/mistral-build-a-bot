# Copy to .env and fill in. Never commit .env. All keys stay server-side.
MISTRAL_API_KEY=
# Optional: deterministic demo mode for the Python parts service (no Mistral API calls)
BFV_MOCK=0
# Optional: Mistral image-generation agent id (agents API) or a direct image model name.
MISTRAL_IMAGE_AGENT_ID=
MISTRAL_IMAGE_MODEL=
# Optional: vision model used by /api/generate for paired photo + JSON workbook generation.
MISTRAL_VISION_MODEL=mistral-large-latest
# Optional: override the Mistral API base URL (default https://api.mistral.ai/v1)
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# Optional: hein-parts FastAPI service URL used by /api/upstream/bom
# HEIN_PARTS_URL=http://localhost:8000
